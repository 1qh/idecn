{
  "name": "idecn",
  "version": "0.0.99",
  "private": false,
  "description": "IDE-like workspace and file tree components for React with material icons",
  "keywords": [
    "react",
    "file-tree",
    "workspace",
    "material-icons",
    "shadcn",
    "ide"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1qh/idecn.git"
  },
  "license": "MIT",
  "author": {
    "name": "Lai Quang Huy",
    "email": "laiquanghuy24122001@gmail.com"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/idecn.d.ts",
      "import": "./dist/idecn.js"
    },
    "./chunk-studio": {
      "types": "./dist/chunk-studio.d.ts",
      "import": "./dist/chunk-studio.js"
    },
    "./styles.css": "./dist/dockview.css"
  },
  "main": "./dist/idecn.js",
  "types": "./dist/idecn.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "gen": "bun scripts/gen-icons.ts && bun scripts/build-registry.ts",
    "prepublishOnly": "bun run build",
    "postpublish": "bun ../../tools/prune-versions.ts",
    "test:registry": "bash scripts/test-registry.sh"
  },
  "dependencies": {
    "@a/ui": "workspace:*",
    "@annotorious/react": "latest",
    "@glideapps/glide-data-grid": "latest",
    "@icons-pack/react-simple-icons": "latest",
    "@monaco-editor/react": "latest",
    "@recogito/react-text-annotator": "latest",
    "@shikijs/monaco": "latest",
    "@tanstack/react-hotkeys": "latest",
    "@tanstack/react-virtual": "latest",
    "dockview-core": "latest",
    "dockview-react": "latest",
    "headrace": "latest",
    "jotai": "latest",
    "leva": "latest",
    "next-themes": "latest",
    "pdfjs-dist": "latest",
    "ragworks": "latest",
    "sonner": "latest",
    "streamdown": "latest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
